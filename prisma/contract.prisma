// use prisma-next

model Issue {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String
  country     String
  state       String
  district    String
  city        String
  locality    String
  supporters  Int      @default(0)
  comments    Int      @default(0)
  status      String   @default("Reported")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("issues")
}
model Comment {
  id        Int      @id @default(autoincrement())
  issueId   Int
  name      String
  content   String
  createdAt DateTime @default(now())

  @@map("comments")
}